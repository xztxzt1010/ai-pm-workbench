{
  "name": "assistant-product-manager",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "test": "vitest run --dir src --maxWorkers=4",
    "test:watch": "vitest --dir src",
    "sidecar:dev": "npm --prefix sidecar start",
    "sidecar:test": "npm --prefix sidecar test",
    "sidecar:build": "npm --prefix sidecar run build",
    "sidecar:verify": "npm --prefix sidecar run verify",
    "verify:p8": "node scripts/verify-p8-flow.mjs",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:security": "node scripts/verify-security.mjs",
    "verify:installer-config": "node scripts/verify-installer-config.mjs",
    "verify:release-manifest": "node scripts/verify-release-manifest.mjs",
    "verify:release-acceptance": "node scripts/verify-release-acceptance.mjs",
    "verify:release-docs": "node scripts/verify-release-docs.mjs",
    "verify:performance": "vitest run performance/performance-budget.test.ts --maxWorkers=1 --disableConsoleIntercept",
    "verify:bundle-budget": "node scripts/verify-bundle-budget.mjs",
    "verify:agent-evals": "node scripts/verify-agent-evals.mjs",
    "inventory:repositioning": "node scripts/generate-repositioning-inventory.mjs --write",
    "verify:repositioning-inventory": "node scripts/generate-repositioning-inventory.mjs --check",
    "verify:knowledge-contract": "node scripts/verify-knowledge-contract.mjs",
    "verify:project-context": "node scripts/verify-project-context.mjs",
    "verify:project-context:live": "node scripts/verify-project-context-live.mjs",
    "verify:project-context:migration-copy": "node scripts/verify-project-context-migration-copy.mjs",
    "verify:preflight": "npm run verify:version-metadata && npm test && npm run sidecar:test && npm run verify:p8 && npm run verify:migrations && npm run verify:knowledge-contract && npm run verify:project-context && npm run verify:security && npm run verify:installer-config && npm run verify:release-manifest && npm run verify:release-acceptance && npm run verify:release-docs && npm run verify:repositioning-inventory && npm run verify:agent-evals && npm run verify:performance && npm run build && npm run verify:bundle-budget",
    "shortcut:create": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-desktop-shortcut.ps1",
    "test:rust": "cargo test --lib --manifest-path src-tauri/Cargo.toml",
    "check:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo check --manifest-path src-tauri/Cargo.toml",
    "quality": "npm run verify:version-metadata && npm test && npm run sidecar:test && npm run verify:migrations && npm run verify:security && npm run build && npm run test:rust && npm run check:rust",
    "verify:version-metadata": "node scripts/verify-version-metadata.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.24.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "read-excel-file": "^9.3.1",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "description": "Local-first AI product manager workspace: project context, knowledge contract, and auditable AI drafts.",
  "author": "xztxzt1010",
  "repository": {
    "type": "git",
    "url": "https://github.com/xztxzt1010/ai-pm-workbench.git"
  },
  "homepage": "https://github.com/xztxzt1010/ai-pm-workbench",
  "bugs": {
    "url": "https://github.com/xztxzt1010/ai-pm-workbench/issues"
  }
}
